# ==============================================================================
# KindCrew Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-at-least-32-chars-long

# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Amazon Cognito
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_DOMAIN=your-cognito-domain.auth.us-east-1.amazoncognito.com
COGNITO_CALLBACK_URL=http://localhost:5000/api/auth/cognito/callback
COGNITO_SIGNOUT_REDIRECT_URI=http://localhost:3000

# Google OAuth (Configured in Cognito Identity Provider)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# DynamoDB Table Names
DYNAMODB_TABLE_USERS=Users
DYNAMODB_TABLE_CREATOR_PROFILES=CreatorProfiles
DYNAMODB_TABLE_IDEAS=ContentIdeas
DYNAMODB_TABLE_CONTENT=ContentDrafts
DYNAMODB_TABLE_SCHEDULED_POSTS=ScheduledPosts

# Amazon Bedrock
BEDROCK_MODEL_ID=google.gemma-3-12b-it
BEDROCK_RESEARCH_MODEL=apac.amazon.nova-pro-v1:0

# Stage I — Web Research (Tavily Search API)
# Optional: Set TAVILY_API_KEY to enable live web search. If omitted, NullWebSearchProvider runs safely as fallback.
TAVILY_API_KEY=
DYNAMODB_RESEARCH_SNAPSHOTS_TABLE=KindCrew-ResearchSnapshots
ENABLE_RESEARCH_SNAPSHOTS=true

# Email Delivery (SMTP / Nodemailer)
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="KindCrew <no-reply@kindcrew.com>"

# EventBridge / Scheduler (Optional)
SCHEDULER_LAMBDA_ARN=
EVENTBRIDGE_BUS_NAME=default
